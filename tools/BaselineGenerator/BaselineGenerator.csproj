<Project Sdk="Microsoft.NET.Sdk">

  <!-- CoverCropper の画像処理を共通エンジンへ置き換える前の基準ファイル（CoverCropper.Tests/Baseline）を作るツール。
       実行方法はリポジトリ直下で: dotnet run (project: tools/BaselineGenerator, 引数: CoverCropper.Tests/Baseline) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CoverCropper\CoverCropper.csproj" />
  </ItemGroup>

</Project>
