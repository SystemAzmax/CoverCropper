<Project Sdk="Microsoft.NET.Sdk">

  <!-- webDeza の MCP サーバー（画面なし。stdio で MCP クライアントとやり取りする。設計書 F-14・5.12）。
       標準出力は MCP の通信に使うので、ログは標準エラー出力に書く -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>webDeza.Mcp</AssemblyName>
    <RootNamespace>WebDeza.Mcp</RootNamespace>
    <AssemblyTitle>webDeza MCP サーバー</AssemblyTitle>
    <Product>webDeza</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebDeza.Imaging\WebDeza.Imaging.csproj" />
    <ProjectReference Include="..\WebDeza.Modules\WebDeza.Modules.csproj" />
  </ItemGroup>

</Project>
