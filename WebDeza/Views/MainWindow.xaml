<Window x:Class="WebDeza.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:root="clr-namespace:WebDeza"
        Title="{x:Static root:AppInfo.ProductName}"
        Width="1440" Height="900" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="AreaBorderBrush" Color="#FFD0D0D0" />

        <!-- ボタンはフォーカスを取らない（キー操作をキャンバスに残すため） -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </Window.Resources>

    <!-- 設計書 4.1 の領域の枠組み。中身は、それぞれの機能を作るステップで入れる -->
    <DockPanel>
        <!-- ツールバー（上） -->
        <Border DockPanel.Dock="Top" Padding="8,6" BorderBrush="{StaticResource AreaBorderBrush}" BorderThickness="0,0,0,1"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <StackPanel x:Name="ToolbarArea" Orientation="Horizontal" MinHeight="26" />
        </Border>

        <!-- ステータスバー（下） -->
        <StatusBar DockPanel.Dock="Bottom" MinHeight="24">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <!-- 画像一覧（左・幅 220） -->
        <Border DockPanel.Dock="Left" Width="220" BorderBrush="{StaticResource AreaBorderBrush}" BorderThickness="0,0,1,0"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <DockPanel x:Name="ImageListArea">
                <TextBlock DockPanel.Dock="Top" Text="画像一覧" Margin="8,6" FontWeight="SemiBold" />
            </DockPanel>
        </Border>

        <!-- 編集パネル（右・幅 300）。スクロールでき、セクションが縦に並ぶ -->
        <Border DockPanel.Dock="Right" Width="300" BorderBrush="{StaticResource AreaBorderBrush}" BorderThickness="1,0,0,0"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel x:Name="EditPanelArea" Margin="8" />
            </ScrollViewer>
        </Border>

        <!-- 道具（キャンバスの左） -->
        <Border DockPanel.Dock="Left" MinWidth="40" BorderBrush="{StaticResource AreaBorderBrush}" BorderThickness="0,0,1,0"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <StackPanel x:Name="ToolArea" Margin="4" />
        </Border>

        <!-- 中央（キャンバス） -->
        <Grid x:Name="CanvasArea" Background="#FF2B2B2B">
            <TextBlock x:Name="PlaceholderText"
                       Text="{x:Static root:Messages.Placeholder}"
                       Foreground="#FFB0B0B0" FontSize="18"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="16"
                       IsHitTestVisible="False" />
        </Grid>
    </DockPanel>
</Window>
