<Window x:Class="WebDeza.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:root="clr-namespace:WebDeza"
        xmlns:vm="clr-namespace:WebDeza.ViewModels"
        xmlns:workspace="clr-namespace:WebDeza.Views.Workspace"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding WindowTitle}"
        Width="1440" Height="900" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        AllowDrop="True"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewDragEnter="OnPreviewDragEnter"
        PreviewDragOver="OnPreviewDragOver"
        PreviewDragLeave="OnPreviewDragLeave"
        PreviewDrop="OnPreviewDrop">

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="O" Command="{Binding OpenCommand}" />
        <KeyBinding Modifiers="Control" Key="W" Command="{Binding CloseCommand}" />
        <KeyBinding Modifiers="Control" Key="A" Command="{Binding SelectAllCommand}" />
        <KeyBinding Modifiers="Control" Key="D" Command="{Binding DeselectCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="X" Command="{Binding CropCommand}" />
        <KeyBinding Modifiers="Control" Key="Tab" Command="{Binding NextDocumentCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="Tab" Command="{Binding PreviousDocumentCommand}" />
        <!-- + / - はキーコードで判定し、Shift の有無は問わない（日本語キーボードでは + を Shift+; で入力するため。設計書 4.4） -->
        <KeyBinding Modifiers="Control" Key="OemPlus" Command="{Binding ZoomInCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="OemPlus" Command="{Binding ZoomInCommand}" />
        <KeyBinding Modifiers="Control" Key="Add" Command="{Binding ZoomInCommand}" />
        <KeyBinding Modifiers="Control" Key="OemMinus" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="OemMinus" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Modifiers="Control" Key="Subtract" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Modifiers="Control" Key="D0" Command="{Binding ZoomToFitCommand}" />
        <KeyBinding Modifiers="Control" Key="NumPad0" Command="{Binding ZoomToFitCommand}" />
        <KeyBinding Modifiers="Control" Key="D1" Command="{Binding ZoomToActualSizeCommand}" />
        <KeyBinding Modifiers="Control" Key="NumPad1" Command="{Binding ZoomToActualSizeCommand}" />
    </Window.InputBindings>

    <!-- 設計書 4.1 の領域の枠組み。中身は、それぞれの機能を作るステップで入れる -->
    <DockPanel>
        <!-- メニューバー（設計書 4.3）。ショートカットの InputGestureText は表示だけで、実際のキーは
             Window.InputBindings で受ける（設計書 5.10-7）。
             IsEnabled="False" の項目は、コマンドを作るステップ（括弧の中）で、ツールバーと同じコマンドにつなぐ。
             「将来」の項目は設計書 8 章の将来拡張で、どんな機能が入るかが分かるように、作るまで無効のまま置いておく -->
        <Menu x:Name="MainMenu" DockPanel.Dock="Top">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="新規画像作成(_N)…" InputGestureText="Ctrl+N" IsEnabled="False" />    <!-- 将来 -->
                <MenuItem Header="開く(_O)…" InputGestureText="Ctrl+O" Command="{Binding OpenCommand}" />
                <MenuItem Header="閉じる(_C)" InputGestureText="Ctrl+W" Command="{Binding CloseCommand}" />
                <MenuItem Header="すべて閉じる(_L)" Command="{Binding CloseAllCommand}" />
                <Separator />
                <MenuItem Header="上書き保存(_S)" InputGestureText="Ctrl+S" IsEnabled="False" />        <!-- 将来 -->
                <MenuItem Header="保存(_E)…" InputGestureText="Ctrl+E" IsEnabled="False" />            <!-- 10-2 -->
                <MenuItem Header="すべて保存(_A)…" InputGestureText="Ctrl+Shift+E" IsEnabled="False" /> <!-- 10-11 -->
                <Separator />
                <MenuItem Header="終了(_X)" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="編集(_E)">
                <MenuItem Header="元に戻す(_U)" InputGestureText="Ctrl+Z" IsEnabled="False" />        <!-- 9-2 -->
                <MenuItem Header="やり直し(_R)" InputGestureText="Ctrl+Y" IsEnabled="False" />        <!-- 9-2 -->
                <Separator />
                <MenuItem Header="コピー(_C)" InputGestureText="Ctrl+C" IsEnabled="False" />          <!-- 将来 -->
                <MenuItem Header="切り取り(_T)" InputGestureText="Ctrl+X" IsEnabled="False" />        <!-- 将来 -->
                <MenuItem Header="貼り付け(_P)" InputGestureText="Ctrl+V" IsEnabled="False" />        <!-- 将来 -->
                <MenuItem Header="透過貼り付け(_A)…" IsEnabled="False" />                             <!-- 将来 -->
                <Separator />
                <MenuItem Header="画像複製(_D)" IsEnabled="False" />                                  <!-- 将来 -->
            </MenuItem>
            <MenuItem Header="選択範囲(_S)">
                <MenuItem Header="すべて選択(_A)" InputGestureText="Ctrl+A" Command="{Binding SelectAllCommand}" />
                <MenuItem Header="選択の取り消し(_D)" InputGestureText="Ctrl+D" Command="{Binding DeselectCommand}" />
                <MenuItem Header="領域選択(_M)" InputGestureText="M" Command="{Binding UseSelectToolCommand}" />
            </MenuItem>
            <MenuItem Header="画像(_I)">
                <MenuItem Header="選択範囲で切り抜き(_P)" InputGestureText="Ctrl+Shift+X" Command="{Binding CropCommand}" />
                <Separator />
                <MenuItem Header="右に 90° 回転(_R)" InputGestureText="Ctrl+R" IsEnabled="False" />   <!-- 9-3 -->
                <MenuItem Header="左に 90° 回転(_L)" InputGestureText="Ctrl+Shift+R" IsEnabled="False" /> <!-- 9-3 -->
                <MenuItem Header="左右反転(_H)" IsEnabled="False" />                                  <!-- 9-3 -->
                <MenuItem Header="上下反転(_V)" IsEnabled="False" />                                  <!-- 9-3 -->
                <MenuItem Header="回転(_T)…" IsEnabled="False" />                                     <!-- 将来（任意角度） -->
                <Separator />
                <MenuItem Header="画像サイズ(_S)…" IsEnabled="False" />                               <!-- 9-4 -->
            </MenuItem>
            <!-- サブメニューに分けない（設計書 F-06）。9-7 で、ぼかしと基本補正を、登録されたフィルター（登録順）の項目に
                 置き換える。それより後ろは、まだ無いフィルター（将来）で、作って登録したら外す -->
            <MenuItem Header="フィルター(_T)">
                <MenuItem Header="ぼかし…" IsEnabled="False" />                                       <!-- 9-7 -->
                <MenuItem Header="基本補正…" IsEnabled="False" />                                     <!-- 9-7 -->
                <MenuItem Header="明度・コントラスト調整…" IsEnabled="False" />                       <!-- 将来 -->
                <MenuItem Header="ガンマ・レベル補正…" IsEnabled="False" />                           <!-- 将来 -->
                <MenuItem Header="色相・彩度調整…" IsEnabled="False" />                               <!-- 将来 -->
                <MenuItem Header="シャープ…" IsEnabled="False" />                                     <!-- 将来 -->
                <MenuItem Header="セピア調…" IsEnabled="False" />                                     <!-- 将来 -->
                <MenuItem Header="グレイスケール…" IsEnabled="False" />                               <!-- 将来 -->
                <MenuItem Header="ネガポジ反転…" IsEnabled="False" />                                 <!-- 将来 -->
                <MenuItem Header="タイリング…" IsEnabled="False" />                                   <!-- 将来 -->
                <MenuItem Header="エンボス…" IsEnabled="False" />                                     <!-- 将来 -->
                <MenuItem Header="CG原画調変換…" IsEnabled="False" />                                 <!-- 将来 -->
                <MenuItem Header="レンガ模様…" IsEnabled="False" />                                   <!-- 将来 -->
                <MenuItem Header="ラスタ効果…" IsEnabled="False" />                                   <!-- 将来 -->
                <MenuItem Header="モザイク…" IsEnabled="False" />                                     <!-- 将来 -->
                <MenuItem Header="カラー合成…" IsEnabled="False" />                                   <!-- 将来 -->
                <MenuItem Header="ノイズ除去…" IsEnabled="False" />                                   <!-- 将来 -->
                <MenuItem Header="エッジ抽出…" IsEnabled="False" />                                   <!-- 将来 -->
            </MenuItem>
            <MenuItem Header="一括処理(_B)">
                <MenuItem Header="一括フォーマット変換(_F)…" IsEnabled="False" />                     <!-- 将来 -->
                <MenuItem Header="一括拡大縮小(_R)…" IsEnabled="False" />                             <!-- 将来 -->
                <MenuItem Header="一括回転(_T)…" IsEnabled="False" />                                 <!-- 将来 -->
            </MenuItem>
            <MenuItem Header="表示(_V)">
                <MenuItem Header="表示拡大(_I)" InputGestureText="Ctrl++" Command="{Binding ZoomInCommand}" />
                <MenuItem Header="表示縮小(_O)" InputGestureText="Ctrl+-" Command="{Binding ZoomOutCommand}" />
                <MenuItem Header="表示サイズ(_S)…" IsEnabled="False" />                               <!-- 将来 -->
                <Separator />
                <MenuItem Header="全体表示(_F)" InputGestureText="Ctrl+0" Command="{Binding ZoomToFitCommand}" />
                <MenuItem Header="100%(_A)" InputGestureText="Ctrl+1" Command="{Binding ZoomToActualSizeCommand}" />
            </MenuItem>
            <!-- 区切りの後に、開いている画像の一覧（アクティブな画像に印）を、メニューを開くたびに作る（MainWindow.xaml.cs） -->
            <MenuItem x:Name="WindowMenu" Header="ウィンドウ(_W)" SubmenuOpened="OnWindowMenuOpened">
                <MenuItem Header="重ねて表示(_C)" Command="{Binding CascadeWindowsCommand}" />
                <MenuItem Header="並べて表示(_T)" Command="{Binding TileWindowsCommand}" />
                <Separator x:Name="WindowListSeparator" />
            </MenuItem>
        </Menu>

        <!-- ツールバー（上。設計書 4.2）。メニューと同じコマンドにつなぐ -->
        <Border DockPanel.Dock="Top" Padding="8,6" BorderThickness="0,1,0,1" Style="{StaticResource AreaBorderStyle}">
            <StackPanel x:Name="ToolbarArea" Orientation="Horizontal" MinHeight="26">
                <Button Content="開く" Command="{Binding OpenCommand}" ToolTip="画像を開く (Ctrl+O)" />
                <Button Content="保存" IsEnabled="False" ToolTip="保存 (Ctrl+E)" />                    <!-- 10-2 -->
                <Border Style="{StaticResource ToolbarSeparatorStyle}" />
                <Button Content="元に戻す" IsEnabled="False" ToolTip="元に戻す (Ctrl+Z)" />            <!-- 9-2 -->
                <Button Content="やり直し" IsEnabled="False" ToolTip="やり直し (Ctrl+Y)" />            <!-- 9-2 -->
                <Border Style="{StaticResource ToolbarSeparatorStyle}" />
                <Button Content="全体" Command="{Binding ZoomToFitCommand}" ToolTip="全体表示 (Ctrl+0)" />
                <Button Content="100%" Command="{Binding ZoomToActualSizeCommand}" ToolTip="100% (Ctrl+1)" />
                <Button Content="－" Command="{Binding ZoomOutCommand}" ToolTip="表示縮小 (Ctrl+-)" />
                <Button Content="＋" Command="{Binding ZoomInCommand}" ToolTip="表示拡大 (Ctrl++)" />
            </StackPanel>
        </Border>

        <!-- ステータスバー（下） -->
        <StatusBar DockPanel.Dock="Bottom" MinHeight="24">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" ToolTip="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <!-- 編集パネル（右・幅 300）。スクロールでき、セクションが縦に並ぶ（折りたためる）。画像が無いときと読み込み中は操作できない -->
        <Border DockPanel.Dock="Right" Width="300" BorderThickness="1,0,0,0" Style="{StaticResource AreaBorderStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel x:Name="EditPanelArea" Margin="8" IsEnabled="{Binding IsEditPanelEnabled}">
                    <!-- 「選択範囲」（設計書 4.1・F-04） -->
                    <Expander x:Name="SelectionSection" Header="選択範囲" IsExpanded="True">
                        <StackPanel Margin="0,4,0,0">
                            <!-- 数値の入力欄: Enter かフォーカスが外れたときに当てはめる（Esc で元の値に戻す） -->
                            <StackPanel.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Margin" Value="0,0,6,0" />
                                </Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="TextAlignment" Value="Right" />
                                    <Setter Property="Margin" Value="0,2,12,2" />
                                    <Setter Property="MaxLength" Value="11" />
                                    <Setter Property="InputMethod.IsInputMethodEnabled" Value="False" />
                                    <EventSetter Event="KeyDown" Handler="OnNumberInputKeyDown" />
                                    <EventSetter Event="GotKeyboardFocus" Handler="OnNumberInputGotKeyboardFocus" />
                                </Style>
                                <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
                            </StackPanel.Resources>
                            <!-- X・Y・幅・高さ。選択範囲が無いときは空欄で入力できない -->
                            <Grid DataContext="{Binding SelectionPanel}" IsEnabled="{Binding HasSelection}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="X" />
                                <TextBox x:Name="SelectionXInput" Grid.Row="0" Grid.Column="1" Text="{Binding XText}" ToolTip="左端の位置 (px)" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Y" />
                                <TextBox x:Name="SelectionYInput" Grid.Row="0" Grid.Column="3" Text="{Binding YText}" ToolTip="上端の位置 (px)" Margin="0,2,0,2" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="幅" />
                                <TextBox x:Name="SelectionWidthInput" Grid.Row="1" Grid.Column="1" Text="{Binding WidthText}" ToolTip="幅 (px)" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="高さ" />
                                <TextBox x:Name="SelectionHeightInput" Grid.Row="1" Grid.Column="3" Text="{Binding HeightText}" ToolTip="高さ (px)" Margin="0,2,0,2" />
                            </Grid>
                            <!-- 比率（全画像で共通。設定に保存する）。変えると、今の選択範囲を中心を保って新しい比率に合わせる -->
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="比率" />
                                <!-- 項目の文字は［縦横を入れ替え］で 4:3 ↔ 3:4 と変わるので、DisplayMemberPath ではなくバインドで出す（選んでいる項目の表示も変わるように） -->
                                <ComboBox x:Name="SelectionAspectCombo" Grid.Column="1" ItemsSource="{Binding AspectOptions}"
                                          SelectedItem="{Binding SelectedAspect}" TextSearch.TextPath="Label" ToolTip="選択範囲の比率">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:AspectOptionViewModel}">
                                            <TextBlock Text="{Binding Label}" Margin="0" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button x:Name="SwapAspectButton" Grid.Column="2" Content="⇄" Command="{Binding SwapAspectCommand}"
                                        ToolTip="縦横を入れ替え" Margin="6,0,0,0" MinWidth="36" />
                            </Grid>
                            <!-- カスタムの比率（幅:高さ。1〜10000） -->
                            <Grid x:Name="CustomAspectArea" Margin="0,4,0,0"
                                  Visibility="{Binding IsCustomAspect, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="幅:高さ" />
                                <TextBox x:Name="CustomAspectWidthInput" Grid.Column="1" Text="{Binding CustomAspectWidthText}"
                                         ToolTip="比率の幅 (1〜10000)" Margin="0,2,0,2" MaxLength="6" />
                                <TextBlock Grid.Column="2" Text=":" Margin="6,0,6,0" />
                                <TextBox x:Name="CustomAspectHeightInput" Grid.Column="3" Text="{Binding CustomAspectHeightText}"
                                         ToolTip="比率の高さ (1〜10000)" Margin="0,2,0,2" MaxLength="6" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="すべて選択" Command="{Binding SelectAllCommand}" ToolTip="すべて選択 (Ctrl+A)" />
                                <Button Content="解除" Command="{Binding DeselectCommand}" ToolTip="選択の取り消し (Ctrl+D)" Margin="8,0,0,0" />
                            </StackPanel>
                            <!-- 画像を選択範囲の大きさにする（選択範囲が無いときは無効） -->
                            <Button x:Name="CropButton" Content="切り抜き" Command="{Binding CropCommand}"
                                    ToolTip="選択範囲で切り抜き (Ctrl+Shift+X)" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 道具（キャンバスの左） -->
        <Border DockPanel.Dock="Left" MinWidth="40" BorderThickness="0,0,1,0" Style="{StaticResource AreaBorderStyle}">
            <!-- 登録された道具のボタン（登録順。設計書 4.2）。ボタンの文字は道具のキー、ツールチップは名前とキー -->
            <ItemsControl x:Name="ToolArea" Margin="4" ItemsSource="{Binding ToolItems}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ToolItemViewModel}">
                        <Button Style="{StaticResource ToolButtonStyle}" Content="{Binding ShortcutText}" ToolTip="{Binding ToolTip}"
                                CommandParameter="{Binding}"
                                Command="{Binding DataContext.SelectToolCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- 中央（ワークスペース）: 画像ごとの子ウィンドウを置く（設計書 F-02） -->
        <Grid x:Name="CanvasArea">
            <workspace:DocumentWorkspace x:Name="Workspace"
                                         Background="{StaticResource WorkspaceBackgroundBrush}"
                                         Documents="{Binding Documents}"
                                         ActiveDocument="{Binding ActiveDocument}"
                                         CurrentTool="{Binding CurrentTool}"
                                         CloseCommand="{Binding CloseCommand}" />

            <!-- 案内文はワークスペースの中央に出し、画像があるときは隠す -->
            <TextBlock x:Name="PlaceholderText"
                       Text="{x:Static root:Messages.Placeholder}"
                       Foreground="{StaticResource CanvasPlaceholderBrush}" FontSize="18"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="16"
                       IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasImage}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- D&D 中のハイライト（受け入れるものを含むときだけ。設計書 F-01）。子ウィンドウより手前に重ねる -->
            <Border x:Name="DropHighlight" Style="{StaticResource DropHighlightStyle}" />
        </Grid>
    </DockPanel>
</Window>
