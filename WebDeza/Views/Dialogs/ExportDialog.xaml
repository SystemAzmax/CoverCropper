<!--
    保存のダイアログ（設計書 F-08・F-10・4.6）。DataContext は ExportDialogViewModel。
    設計書 4.6 の図の右側（設定）にあたる。左のプレビュー（10-8・10-9）、形式とオプション（10-3）、背景色（10-4）、
    保存サイズ（10-6）は、それぞれのステップで足す
-->
<Window x:Class="WebDeza.Views.Dialogs.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WebDeza.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ExportDialogViewModel}"
        Title="{Binding Title}"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <Grid Margin="16">
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!-- 項目名の列 -->
            <Style x:Key="LabelStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Margin" Value="0,0,16,10" />
            </Style>
            <!-- ダイアログのボタンは、メインウィンドウと違ってフォーカスを取ってよい（Tab で選べるように） -->
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Focusable" Value="True" />
                <Setter Property="MinWidth" Value="88" />
                <Setter Property="Margin" Value="8,0,0,0" />
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource LabelStyle}" Text="形式" />
        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="FormatText" Text="{Binding FormatText}" VerticalAlignment="Top" Margin="0,0,0,10" />

        <TextBlock Grid.Row="1" Style="{StaticResource LabelStyle}" Text="大きさ" />
        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SizeText" Text="{Binding SizeText}" VerticalAlignment="Top" Margin="0,0,0,10"
                   ToolTip="今の画像の大きさのまま保存します（大きさは［画像］→［画像サイズ…］で変えます）" />

        <!-- 出力先: パスは長いので折り返し、全体をツールチップにも出す -->
        <TextBlock Grid.Row="2" Style="{StaticResource LabelStyle}" Text="出力先" />
        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
            <TextBlock x:Name="OutputFolderText" Text="{Binding OutputFolderText}" ToolTip="{Binding OutputFolderText}"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="ChangeFolderButton" Content="変更…" Command="{Binding ChangeFolderCommand}" Margin="0"
                        ToolTip="出力先のフォルダを選ぶ" />
                <Button x:Name="OpenFolderButton" Content="開く" Command="{Binding OpenFolderCommand}"
                        ToolTip="出力先のフォルダをエクスプローラーで開く" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="3" Style="{StaticResource LabelStyle}" Text="ファイル名" />
        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="FileNameText" Text="{Binding FileName}" TextWrapping="Wrap"
                   VerticalAlignment="Top" Margin="0,0,0,10"
                   ToolTip="日時の部分は、保存したときの日時になります。同じ名前があれば _2, _3 … を付けます" />

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="SaveButton" Content="保存" IsDefault="True" Command="{Binding SaveCommand}" />
            <Button x:Name="CancelButton" Content="キャンセル" IsCancel="True" IsEnabled="{Binding IsIdle}" />
        </StackPanel>
    </Grid>
</Window>
