<Window x:Class="CoverCropper.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:CoverCropper.Views.Controls"
        xmlns:vm="clr-namespace:CoverCropper.ViewModels"
        xmlns:root="clr-namespace:CoverCropper"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding WindowTitle}"
        Icon="/Assets/AppIcon.ico"
        Width="1280" Height="900" MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        AllowDrop="True"
        PreviewDragEnter="OnPreviewDragOver"
        PreviewDragOver="OnPreviewDragOver"
        PreviewDragLeave="OnPreviewDragLeave"
        PreviewDrop="OnPreviewDrop"
        PreviewKeyDown="OnPreviewKeyDown"
        Closing="OnClosing">

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="O" Command="{Binding OpenCommand}" />
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ツールバー -->
        <Border DockPanel.Dock="Top" Padding="8,6" BorderBrush="#FFD0D0D0" BorderThickness="0,0,0,1"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Content="開く" Command="{Binding OpenCommand}" ToolTip="画像を開く (Ctrl+O)" />
                    <Button Content="保存" Command="{Binding SaveCommand}" ToolTip="切り抜いて保存 (Ctrl+S)" />
                    <Button Content="中央に戻す" Command="{Binding ResetPositionCommand}" ToolTip="枠を中央に戻す (Home)" />
                </StackPanel>

                <DockPanel Grid.Column="1" Margin="16,0,8,0" VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Left" Text="保存先:" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding OutputFolderDisplay}" ToolTip="{Binding OutputFolderDisplay}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="変更…" Command="{Binding ChangeOutputFolderCommand}" ToolTip="保存先フォルダを変更" />
                    <Button Content="開く" Command="{Binding OpenOutputFolderCommand}" ToolTip="保存先フォルダをエクスプローラーで開く"
                            Margin="0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ステータスバー -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <!-- プレビュー -->
        <Grid Background="#FF2B2B2B">
            <controls:CropCanvas x:Name="CropView"
                                 Source="{Binding ResizedImage}"
                                 CropX="{Binding CropX}"
                                 CropY="{Binding CropY}" />

            <TextBlock Text="{x:Static root:Messages.Placeholder}"
                       Foreground="#FFB0B0B0" FontSize="18"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasImage}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- D&D 中のハイライト -->
            <Border x:Name="DropHighlight" Visibility="Collapsed" IsHitTestVisible="False"
                    Margin="6" BorderThickness="3" BorderBrush="#FF3A96DD" Background="#203A96DD"
                    CornerRadius="4" />
        </Grid>
    </DockPanel>
</Window>
