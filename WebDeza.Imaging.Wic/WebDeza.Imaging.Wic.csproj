<Project Sdk="Microsoft.NET.Sdk">

  <!-- 標準の形式プラグイン。WIC（WPF の System.Windows.Media.Imaging）で画像ファイルを読み書きする -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebDeza.Imaging\WebDeza.Imaging.csproj" />
  </ItemGroup>

</Project>
